      "updated": 1790084751579,
      "created": 1790068559099,
      "link": null,
      "locked": false,
      "text": "Data Model\n\nUser:\n-Id\n-Role\n-Name\n-Email\n-Password_hash\n----------------\nProduct:\n-Id\n-Name\n-Description\n-Price\n-Amount\n-ThumbnailUrl\n-CreatedAt\n-UpdatedAt\n----------------\nOrder:\n-Id\n-OrderCode\n-List<OrderItem>\n-Status\n-createdAt\n-updatedAt\n----------------\nOrderItem:\n-Id\n-Product_id\n-Quantity\n----------------\nRobot:\n-Id\n-Name\n-Location\n----------------\nInventoryLocation:\n-Id\n-ProductId\n-LocationId\n-Quantity\n-ReservedQuantity\n----------------\nLocation:\n-Id\n-Title\n-Lat\n-Long\n----------------\nNotification:\n-Id\n-Title\n-Body\n----------------\n\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data Model\n\nUser:\n-Id\n-Role\n-Name\n-Email\n-Password_hash\n----------------\nProduct:\n-Id\n-Name\n-Description\n-Price\n-Amount\n-ThumbnailUrl\n-CreatedAt\n-UpdatedAt\n----------------\nOrder:\n-Id\n-OrderCode\n-List<OrderItem>\n-Status\n-createdAt\n-updatedAt\n----------------\nOrderItem:\n-Id\n-Product_id\n-Quantity\n----------------\nRobot:\n-Id\n-Name\n-Location\n----------------\nInventoryLocation:\n-Id\n-ProductId\n-LocationId\n-Quantity\n-ReservedQuantity\n----------------\nLocation:\n-Id\n-Title\n-Lat\n-Long\n----------------\nNotification:\n-Id\n-Title\n-Body\n----------------\n\n",
      "autoResize": true,
